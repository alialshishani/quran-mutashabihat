# Virtualenv and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Derived corpus: rebuilt from data/raw/ by `python -m pipeline.ingest --rebuild`.
data/quran.db
data/interim/

# QUL downloads. Licensed source files fetched by hand per docs/DOWNLOAD.md;
# data/raw/PROVENANCE.md records every checksum and licence and IS tracked.
data/raw/*
!data/raw/PROVENANCE.md
# Checksums of the KFGQPC fonts and glyph codes fetched by scripts.fetch_qcf.
# The 69 MB they describe stays out; the record of exactly what was fetched
# belongs in the repository.
!data/raw/qcf-v1-manifest.json

# The Flutter app's assets are built from data/ by mobile/tools/stage_assets.py:
# the corpus, the 604 KFGQPC page fonts, and two fetched files. None of them are
# this repository's to redistribute, and none are worth versioning.
mobile/app/assets/
mobile/app/web/sqlite3.wasm

# Flutter and Gradle build output.
mobile/**/build/
mobile/**/.dart_tool/
mobile/**/.gradle/
mobile/**/.kotlin/
mobile/**/*.iml
mobile/app/android/local.properties
mobile/**/pubspec.lock

# Golden files for the port's verification: regenerated by mobile/tools/dump_*.py
# from the Python, and far too large to version.
mobile/golden*/
mobile/app/.flutter-plugins-dependencies
